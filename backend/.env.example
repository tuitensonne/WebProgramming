# Database Configuration
DB_HOST=localhost
DB_NAME=webtravel
DB_USER=root
DB_PASS=
DB_PORT=3307
DB_CHARSET=utf8mb4

# JWT Configuration
key=dev-secret-key-change-in-production
issuer=bk-tours
audience=bk-tours-client
expire=3600

# SMTP Configuration (for email sending)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Your Website

# AWS S3 Configuration (optional - for file uploads)
BUCKET_NAME=
REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Application Configuration
APP_ENV=development
APP_DEBUG=true