RewriteEngine On
# Adjust RewriteBase for local XAMPP DocumentRoot
RewriteBase /ltweb/btl/WebProgramming/backend/public/

# Optional prerender proxy rule removed/disabled for local development
# RewriteCond %{HTTP_USER_AGENT} (googlebot|bingbot|yandex|baiduspider|facebookexternalhit|twitterbot|linkedinbot) [NC]
# RewriteCond %{REQUEST_URI} !\.(js|css|xml|png|jpg|jpeg|gif|pdf|txt|ico|zip|webp)$ [NC]
# RewriteCond %{REQUEST_FILENAME} !-f
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.*)$ https://service.prerender.io/https://yourdomain.com/ltweb/btl/WebProgramming/backend/public/$1 [P,L,E=PRERENDER_TOKEN:9OyivQX988oJ5EUO6NAt]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(.*)$ index.php [L,QSA]